{
  "$schema": "https://typedoc.org/schema.json",
  "name": "jspdf-toolkit",
  "entryPoints": ["src/index.ts", "src/node/index.ts", "src/fonts/inter/index.ts"],
  "entryPointStrategy": "resolve",
  "tsconfig": "tsconfig.json",
  "out": "docs/api",
  "readme": "README.md",
  "projectDocuments": ["docs/components/README.md"],
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "navigation": { "includeCategories": false, "includeGroups": true },
  "groupOrder": [
    "Classes",
    "Functions",
    "Variables",
    "Interfaces",
    "Type Aliases",
    "Constructors",
    "Text",
    "Lists",
    "Fields and forms",
    "Boxes",
    "Table",
    "Charts",
    "Layout blocks",
    "Page elements",
    "Images",
    "Flow control",
    "Layout",
    "Export",
    "Properties",
    "*"
  ],
  "sort": ["kind", "alphabetical"],
  "gitRevision": "main",
  "navigationLinks": { "GitHub": "https://github.com/mlt-a/jspdf-toolkit" },
  "requiredToBeDocumented": [
    "Class",
    "Interface",
    "TypeAlias",
    "Variable",
    "Function",
    "Method",
    "Accessor",
    "Constructor",
    "Property"
  ],
  "validation": { "notExported": true, "invalidLink": true, "notDocumented": true },
  "treatWarningsAsErrors": true,
  "treatValidationWarningsAsErrors": true
}
